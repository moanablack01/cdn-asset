			<div class="flex flex-col gap-1" id="trending-review-wrapper">
    <div class="text-[22px] font-bold">Trending Review</div>
</div>
<div class="grid gap-4 pb-4" id="trending-review-list"></div>
<script>
    (function () {
        'use strict';

        const API_URL = 'https://api-rating-review.detik.com/fe-portal/featured-review/?site=rekomendit&rows=10&page=1';
        const MAX_STAR = 5;
        const STAR_COLOR_ACTIVE = '#FDD264';
        const STAR_COLOR_INACTIVE = '#FFEEC1';

        function buildStarSvg(fillColor) {
            return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="w-6 h-6">
                <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" fill="${fillColor}"></path>
            </svg>`;
        }

        const STAR_SVG_ACTIVE = buildStarSvg(STAR_COLOR_ACTIVE);
        const STAR_SVG_INACTIVE = buildStarSvg(STAR_COLOR_INACTIVE);

        function escapeHtml(value) {
            const text = String(value ?? '');
            const escapeMap = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            };
            return text.replace(/[&<>"']/g, (char) => escapeMap[char]);
        }

        function getStarCount(rawRating) {
            const rating = Number(rawRating);
            return Number.isNaN(rating) ? 0 : Math.floor(rating);
        }

        function buildStarsHtml(starCount) {
            let stars = '';
            for (let i = 0; i < MAX_STAR; i++) {
                stars += i < starCount ? STAR_SVG_ACTIVE : STAR_SVG_INACTIVE;
            }
            return stars;
        }

        function buildReviewItemHtml(item) {
            const starCount = getStarCount(item.average_rating_per_review);
            const starsHtml = buildStarsHtml(starCount);

            const userName = escapeHtml(item.user_name || 'User');
            const userPhoto = escapeHtml(item.user_photo || '');
            const articleUrl = escapeHtml(item.url || '#');
            const articleTitle = escapeHtml(item.title || '');
            const reviewContent = escapeHtml(item.content || '');

            return `
                <div class="flex gap-6 max-[767px]:gap-[10px] items-start min-w-0">
                    <div class="flex flex-col items-center shrink-0">
                        <img src="${userPhoto}" alt="${userName}" loading="lazy" decoding="async" fetchpriority="auto" width="60" height="60" class="w-[60px] h-[60px] max-[767px]:w-[32px] max-[767px]:h-[32px] rounded-full object-cover">
                        <div class="w-[2px] h-[147px] max-[767px]:h-[210px] bg-[#F0F0F0]"></div>
                    </div>
                    <div class="flex flex-col gap-[18px] max-[767px]:gap-3 bg-[#F7F7F7] rounded-[40px] px-6 max-[767px]:px-4 pt-[14px] max-[767px]:pt-6 pb-[18px] max-[767px]:pb-6 w-full min-w-0">
                        <div class="flex flex-col gap-1">
                            <p class="text-base max-[767px]:text-sm">
                                <span class="font-semibold text-[#1A1A1A]">${userName}</span>
                                <span class="text-[#666] max-[767px]:hidden"> memberikan review produk di </span>
                                <span class="text-[#666] min-[768px]:hidden"> memberikan review produk di </span>
                                <span class="text-[#666] italic">artikel:</span>
                            </p>
                            <a href="${articleUrl}" dtr-evt="box trending review" dtr-sec="trending review"
                                target="_blank"
                                dtr-act="trending review"
                                onclick="_pt(this)"
                                dtr-id="474"
                                dtr-ttl="Retouch Intercom X5 Pro, Partner Andalan untuk Touring Jarak Jauh" class="bg-[#FDE3A5] rounded-[20px] px-5 py-[10px] max-[767px]:px-[14px] w-full shadow-[0px_4px_5px_rgba(82,82,82,0.1)]">
                                <p class="font-bold text-base max-[767px]:text-sm text-[#424242] min-[768px]:truncate max-[767px]:line-clamp-2">${articleTitle}</p>
                            </a>
                        </div>
                        <div class="flex flex-col gap-1">
                            <p class="text-[15px] max-[767px]:text-[13px] max-[767px]:line-clamp-3 text-[#424242]">${reviewContent}</p>
                        </div>
                    </div>
                </div>
            `;
        }

        function removeTrendingReviewBlock() {
            const wrapper = document.getElementById('trending-review-wrapper');
            const container = document.getElementById('trending-review-list');
            if (wrapper) {
                wrapper.remove();
            }
            if (container) {
                container.remove();
            }
        }

        function renderTrendingReviews(items) {
            const container = document.getElementById('trending-review-list');
            if (!container) {
                return;
            }
            container.innerHTML = items.map(buildReviewItemHtml).join('');
        }

        function loadTrendingReviews() {
            fetch(API_URL, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then((result) => {
                    const items = result?.records;
                    if (!Array.isArray(items) || items.length === 0) {
                        removeTrendingReviewBlock();
                        return;
                    }
                    renderTrendingReviews(items);
                })
                .catch((error) => {
                    console.error('Error memuat trending review:', error);
                    removeTrendingReviewBlock();
                });
        }

        loadTrendingReviews();
    })();
</script>			





 
        </div>
    </div>
</div>



		<!-- e: content -->

		<div id="fab-rekomendit"></div>

<script type="text/javascript">
    let statusLive = "off";
    const sourceControl = "detail";

    document.addEventListener("DOMContentLoaded", async () => {
        if (sourceControl === "Index") {
            const data = await fetchShowLiveStreaming();
            if (data.status === "on") {
                statusLive = "on";
                fetchShowLiveShopping();
            } else if (data.status === "off" && data.catalogid) {
                fetchShowCatalog();
            }
            initWebSocket();
        } else if (sourceControl !== "errors") {
            await fetchShowFab();
        }
    });

    function initWebSocket() {
        const ws = new WebSocket("wss://push.detik.com/ws/rekomendit");

        ws.onmessage = function (event) {
            try {
                const data = JSON.parse(event.data);
                handleWebSocketMessage(data);
            } catch (err) {
                console.error("WebSocket error:", err);
            }
        };
    }

    function handleWebSocketMessage(data) {
        const isOn = data.status === "on";
        const isOff = data.status === "off";
        const isRekom = data.type === "rekomendit";
        const isCatalog = data.type === "update_catalogue_rekomendit";
        const liveOn = statusLive === "on";
        const liveOff = statusLive === "off";

        if (isOn && isRekom) {
            statusLive = "on";
            setTimeout(fetchShowLiveShopping, 1000);
        } else if (liveOn && isCatalog) {
            fetchUpdateCatalog();
        } else if (isOff && liveOn && isRekom) {
            $("#liveshopping-trigger").html("");
            statusLive = "off";
            setTimeout(fetchShowCatalog, 1000);
        } else if (isOff && liveOff && isRekom) {
            setTimeout(fetchShowCatalog, 1000);
        }
    }

    async function fetchShowLiveStreaming() {
        const url = "https://rekomendit.detik.com/api/liveshopping/showlivestreaming";
        try {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                },
            });
            return (await response.json()) || [];
        } catch (error) {
            console.error("fetchShowLiveStreaming error:", error);
            return [];
        }
    }

    async function fetchShowFab() {
        const url = "https://rekomendit.detik.com/api/liveshopping/showfab";
        try {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                },
            });
            const result = await response.json();
            $("#fab-rekomendit").html(result || "");
        } catch (error) {
            console.error("fetchShowFab error:", error);
        }
    }

    async function fetchShowLiveShopping() {
        const url = "https://rekomendit.detik.com/api/liveshopping/showliveshopping";
        try {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                },
            });
            const result = await response.json();
            $("#liveshopping-trigger").html(result || "");
        } catch (error) {
            console.error("fetchShowLiveShopping error:", error);
        }
    }

    async function fetchShowCatalog() {
        const url = "https://rekomendit.detik.com/api/liveshopping/showfloatingcatalog";
        try {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                },
            });
            const result = await response.json();
            $("#float-catalog").html(result || "");
        } catch (error) {
            console.error("fetchShowCatalog error:", error);
        }
    }

    async function fetchUpdateCatalog() {
        const url = "https://rekomendit.detik.com/api/liveshopping/update_catalog";
        try {
            const response = await fetch(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest",
                },
            });
            const result = await response.json();
            $("#list-item-catalog").html(result || "");
        } catch (error) {
            console.error("fetchUpdateCatalog error:", error);
        }
    }
</script>		
