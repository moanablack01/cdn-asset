<script lang="js">
    // LOVE BTN
    const loveBtns = document.querySelectorAll('.love-btn');

    loveBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const path = btn.querySelector('path');
            if (path) {
                const currentFill = path.getAttribute('fill');
                if (currentFill === '#BE780D') {
                    path.setAttribute('fill', 'none');
                    path.setAttribute('stroke', 'black');
                } else {
                    path.setAttribute('fill', '#BE780D');
                    path.setAttribute('stroke', '#BE780D');
                }
            }
        });
    });

    // SAVED BTN
    const savedBtns = document.querySelectorAll('.saved-btn');

    savedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const path = btn.querySelector('path');
            if (path) {
                const currentFill = path.getAttribute('fill');
                if (currentFill === '#BE780D') {
                    path.setAttribute('fill', 'none');
                    path.setAttribute('stroke', 'black');
                } else {
                    path.setAttribute('fill', '#BE780D');
                    path.setAttribute('stroke', '#BE780D');
                }
            }
        });
    });



    //SHARE
    const shareBtn = document.getElementById('shareBtn');
    shareBtn.addEventListener('click', async () => {
        const shareData = {
            title: 'Retouch Intercom X5 Pro, Partner Andalan untuk Touring Jarak Jauh',
            text: 'Komunikasi stabil dan suara jelas, berkat interkom pintar yang siap menemani perjalanan panjang.',
            url: window.location.href
        };

        // Check if device supports Web Share API
        if (navigator.share) {
            try {
                await navigator.share(shareData);
                console.log('Content shared successfully');
            } catch (err) {
                console.error('Error sharing:', err);
            }
        } else {
            // Fallback: copy link to clipboard
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('Link copied to clipboard!');
            });
        }
    });
</script>
