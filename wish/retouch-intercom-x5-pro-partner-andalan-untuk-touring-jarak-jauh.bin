<div id="showmodaldialog"></div>		<script type="text/javascript">
    var baseurl = 'https://rekomendit.detik.com';
    const storageKeys = `"a6dba1c73ba553fa191ad849005c6974"`;
</script>

<script lang="js">
    //SUB FLIP MOBILE
    const subFlipBtns = document.querySelectorAll('.sub-flip-btn');
    const backBtns = document.querySelectorAll('.back-btn');
    const closeBtn = document.querySelector('.close-flip');

    subFlipBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            // close semua
            btn.closest('ul')
                .querySelectorAll('.sub_flip')
                .forEach(el => el.classList.add('hidden'));
            
            const subMenu = btn.nextElementSibling;
            const container = document.querySelector('.open_menu_mobile');
            if (subMenu) {
                subMenu.classList.remove('hidden');

                // ✅ scroll ke atas (reliable)
                container.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }
        });
    });

    backBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const subMenu = btn.closest('.sub_flip');
            if (subMenu) {
                subMenu.classList.add('hidden');
            }
        });
    });

    closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const subMenu = document.querySelector('.sub_flip');
        if (subMenu) {
            subMenu.classList.add('hidden');
        }
    });

    //DROPDOWN MENU
    const parent_menus = document.querySelectorAll(".parent_menu");
    parent_menus.forEach(parent_menu => {
        const btn = parent_menu.querySelector('.menu-btn');

        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            parent_menus.forEach(d => {
                if (d !== parent_menu) d.classList.remove('active')
            });
            parent_menu.classList.toggle('active')
        })
    });
    document.addEventListener('click', () => {
        parent_menus.forEach(d => d.classList.remove('active'));
    })

    // SCROLL HEADER STICKY
    let lastScroll = 0;
    var header = document.getElementById("header");
    // var navbarHeight = header.offsetHeight;
    // var logo_header = document.getElementById("logo_header");
    // var logo_sticky = document.getElementById("logo_sticky");
    // var navbar_sticky = document.getElementById("navbar_sticky");
    // var nav_header = document.getElementById("nav_header");
    // var search_menu = document.getElementById("search_menu");
    var menu_scroll = document.getElementById("menu_scroll");

    // fungsi utama
    function handleScroll() {

        if (!menu_scroll) return; // 🔥 penting
        // hanya aktif jika layar > 768px (desktop)
        if (window.innerWidth <= 768) return;

        const currentScroll = window.pageYOffset;

        if (currentScroll > 0 && currentScroll > lastScroll) {
            // Scroll down
            // logo_header.classList.add("hidden");
            // logo_sticky.classList.remove("invisible");
            // nav_header.classList.add("flex");
            // nav_header.classList.remove("grid");
            // search_menu.classList.add("left-[38%]");
            menu_scroll.classList.remove("hidden");
        } else if (currentScroll <= 0) {
            // Scroll up sampai top
            // logo_header.classList.remove("hidden");
            // logo_sticky.classList.add("invisible");
            // nav_header.classList.remove("flex");
            // nav_header.classList.add("grid");
            // search_menu.classList.remove("left-[38%]");
            menu_scroll.classList.add("hidden");    
        }

        lastScroll = currentScroll;
    }

    // jalankan saat scroll
    window.addEventListener("scroll", handleScroll);

    // handle perubahan ukuran layar
    window.addEventListener("resize", handleScroll);

    //DROP NAV MENU MOBILE
    const dropdowns = document.querySelectorAll('.dropdown');
    dropdowns.forEach(dropdown => {
        const btn = dropdown.querySelector('.dropdown-btn');
        const content = dropdown.querySelector('.dropdown-content');

        btn.addEventListener('click', (e) => {
        const isOpen = content.classList.contains('show');

        // Close all dropdowns
        dropdowns.forEach(d => d.querySelector('.dropdown-content').classList.remove('show'));

        // If it wasn't open, open it now
        if (!isOpen) {
            content.classList.add('show');
        }
        });

        // Close when clicking an item
        content.querySelectorAll('a').forEach(item => {
        item.addEventListener('click', () => {
            content.classList.remove('show');
        });
        });
    });


    // Close when clicking outside
    window.addEventListener('click', (e) => {
        if (!e.target.closest('.dropdown')) {
        dropdowns.forEach(dropdown => {
            dropdown.querySelector('.dropdown-content').classList.remove('show');
        });
        }
    });

    // Only run on desktop (min-width: 768px)
    window.addEventListener("scroll", function () {
        const disclaimer = document.getElementById("disclaimer-sticky");
        if (!disclaimer) return;

        // Responsive check: only apply on desktop
        if (window.innerWidth < 768) {
        disclaimer.classList.remove("bg-white");
        disclaimer.classList.add("bg-transparent");
        return;
        }

        if (window.scrollY > 55) {
        disclaimer.classList.add("bg-white");
        disclaimer.classList.remove("bg-transparent");
        } else {
        disclaimer.classList.remove("bg-white");
        disclaimer.classList.add("bg-transparent");
        }
    });

    //DROPDOWN SUGGEST
    const dropdown_suggest = document.getElementById("dropdown_suggest");
    const suggestList = document.getElementById("suggestList");
    const searchInput = document.getElementById("searchInput");
    const dropdownDefault = document.getElementById("dropdown_default");
    const searchMenu = document.getElementById("search_menu");
    const closeSearchDropdown = document.getElementById("close_search_dropdown");
    let defaultHeight = 0;

    const searchIcon = document.getElementById("search_icon");

    // Capture height when content is likely loaded or on first interaction if needed.
    window.addEventListener('load', () => {
         if(dropdownDefault) {
             // Temporarily show to measure if hidden
             const wasHidden = dropdownDefault.classList.contains('hidden');
             if(wasHidden) {
                 dropdownDefault.classList.remove('hidden');
                 dropdownDefault.style.visibility = 'hidden';
                 dropdownDefault.style.position = 'absolute';
                 
             }
             
             defaultHeight = dropdownDefault.offsetHeight;
             
             if(wasHidden) {
                 dropdownDefault.classList.add('hidden');
                 dropdownDefault.style.visibility = '';
                 dropdownDefault.style.position = '';
             }
         }
    });

    searchInput.addEventListener('focus', () => {
        closeSearchDropdown.classList.remove('hidden');
        if (window.innerWidth < 768) {
             searchIcon.classList.add('hidden');
        }
        if (searchInput.value.trim() === '') {
            dropdownDefault.classList.remove('hidden');
            dropdown_suggest.classList.add('hidden');
        } else {
             // Trigger input event logic if needed, or let the input event handle it.
             // If value exists, we probably want to show suggestions if they were hidden.
             // But usually input event handles that. 
             // If we just focus back, we might want to reshow suggestions.
             if (suggestList.children.length > 0) {
                 dropdown_suggest.classList.remove('hidden');
                 dropdownDefault.classList.add('hidden');
             }
        }
    });
    
    // Prevent closing when clicking inside search menu
    searchMenu.addEventListener('click', (e) => {
        e.stopPropagation();
    });

    // Close when clicking outside
    document.addEventListener('click', () => {
        dropdownDefault.classList.add('hidden');
        dropdown_suggest.classList.add('hidden');
        closeSearchDropdown.classList.add('hidden');
        searchIcon.classList.remove('hidden');
    });

    closeSearchDropdown.addEventListener('click', (e) => {
         e.stopPropagation();
         dropdownDefault.classList.add('hidden');
         dropdown_suggest.classList.add('hidden');
         closeSearchDropdown.classList.add('hidden');
         searchIcon.classList.remove('hidden');

         if (window.innerWidth <= 767) {
            searchMenu.classList.remove("max-[767px]:fixed", "max-[767px]:z-[123]", "max-[767px]:w-full", "max-[767px]:h-[64px]", "max-[767px]:left-0", "max-[767px]:bg-white");
            searchMenu.classList.add("mt-2", "left-4", "max-[767px]:absolute");
         }
    });

    searchInput.addEventListener("input", async function () {
        const query = searchInput.value.toLowerCase();
        
        // Fallback if load event missed or 0
        if (defaultHeight === 0 && dropdownDefault) {
             // Try to measure again
             const wasHidden = dropdownDefault.classList.contains('hidden');
             if(wasHidden) {
                 dropdownDefault.classList.remove('hidden');
                 dropdownDefault.style.visibility = 'hidden';
                 dropdownDefault.style.position = 'absolute';
             }
             defaultHeight = dropdownDefault.offsetHeight;
             if(wasHidden) {
                 dropdownDefault.classList.add('hidden');
                 dropdownDefault.style.visibility = '';
                 dropdownDefault.style.position = '';
             }
        }

    });

    // MOVE SEARCH IN MOBILE
    document.addEventListener("DOMContentLoaded", function () {
        const searchMenu = document.getElementById("search_menu");
        const originalParent = searchMenu.parentNode;
        const originalNext = searchMenu.nextElementSibling;
        const openSearchMobile = document.getElementById("open_search_mobile");
        const closeSearchDropdown = document.getElementById("close_search_dropdown");

        // OPEN SEARCH (MOBILE ONLY)
        openSearchMobile.addEventListener("click", function (e) {
            if (window.innerWidth > 767) return; // ❗ hanya mobile

            e.stopPropagation();
            searchMenu.classList.add("max-[767px]:fixed", "max-[767px]:z-[123]", "max-[767px]:w-full", "max-[767px]:h-[64px]", "max-[767px]:left-0", "max-[767px]:bg-white");
            searchMenu.classList.remove("absolute", "mt-2", "mr-[-100%]", "left-[38%]", "left-4", "max-[767px]:absolute");
            closeSearchDropdown.classList.add('hidden');
            
        });

        // CLOSE SEARCH (OUTSIDE CLICK) — MOBILE ONLY
        document.addEventListener("click", function (e) {
            if (window.innerWidth > 767) return; // ❗ hanya mobile

            if (!searchMenu.contains(e.target) && !openSearchMobile.contains(e.target)) {
                searchMenu.classList.remove("max-[767px]:z-[123]", "max-[767px]:w-full", "max-[767px]:h-[64px]", "max-[767px]:left-0", "left-[38%]", "max-[767px]:bg-white", "opacity-0");
                searchMenu.classList.add("mt-2", "left-4", "max-[767px]:absolute"); 
            }
        });

        // RELOCATE ELEMENT
        function relocate() {
            if (window.innerWidth <= 767) {
                // pindah ke <body>
                if (searchMenu.parentNode !== document.body) {
                    document.body.insertBefore(searchMenu, document.body.firstChild.nextSibling);
                    searchMenu.classList.add("mt-2", "left-4", "max-[767px]:absolute"); 
                }
            } else {
                // kembalikan ke posisi asli
                if (searchMenu.parentNode === document.body) {
                    if (originalNext) {
                        originalParent.insertBefore(searchMenu, originalNext);
                    } else {
                        originalParent.appendChild(searchMenu);
                    }
                    searchMenu.classList.add("max-[767px]:absolute", "left-4");
                    searchMenu.classList.remove("mt-2");
                }
            }
        }

        relocate();
        window.addEventListener("resize", relocate);
    });

    //DROPDOWN PROFILE
    const menu_profile = document.getElementById("menu_profile")
    const dropdown_profile =document.getElementById("dropdown_profile")
    if(menu_profile){
        menu_profile.addEventListener('click', (e) => {
            e.stopPropagation()
            dropdown_profile.classList.add('flex')
            dropdown_profile.classList.remove('hidden')
        });
        document.addEventListener('click', () => {
            dropdown_profile.classList.remove('flex')
            dropdown_profile.classList.add('hidden')
        });
    }

    function clickBackBtnFunc(e) {
        e.preventDefault();
        e.stopPropagation();
        const subMenu = e.target.closest('.sub_flip');
        if (subMenu) {
            subMenu.classList.add('hidden');
        }
    }

</script>

