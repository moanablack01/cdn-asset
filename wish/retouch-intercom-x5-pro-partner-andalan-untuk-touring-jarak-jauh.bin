<script defer type="text/javascript" src="https://cdn.detik.net.id/libs/dc/v1/detikconnect_auto_login.js"></script>
                <script type="text/javascript">
                    $(document).ready(function() {
                        detikConnectAutoLogin(10389, false, onLoginClient);
                    }); 
                </script>
<script type='text/javascript'>
    function onLoginClient(data) {
		window.__AUTH__ = data
        document.dispatchEvent(new CustomEvent('login:client', { detail: window.__AUTH__ }));
		 var menu_scroll = document.getElementById("menu_scroll");

        if (data.is_login) {

            if (!data.is_verify_adult) {
                                                                }

            var fullname = (`${data.first_name} ${data.last_name}`);
            $('.connectDetikAvatar').attr('src', data.avatar);
            $('.connectDetikAvatar').attr('alt', fullname);
            $('.UsernameInfo').text(fullname);
			$('.UsernameInfoMobile').text(fullname);
            $('.UsernameInfo').attr('href', `https://connect.detik.com/dashboard/`);
            $('#header-not-login').addClass('hidden');
            $('#header-login').removeClass('hidden');

            $('#header-not-login-mobile').addClass('hidden');
            $('#header-login-mobile').removeClass('hidden');
            $('.HasLogin').show();
			menu_scroll.style.display = '';
			$('#menu_scroll').addClass('hidden');

            $('.login').hide();
            $('.NotLogin').hide();
			getCatItem()
        } else {
                                                    $('#header-login').addClass('hidden');
            $('#header-not-login').removeClass('hidden');

            $('#header-login-mobile').addClass('hidden');
			menu_scroll.style.display = 'none';
            $('#header-not-login-mobile').removeClass('hidden');

			$('#btn-logout-dc').remove();
            $('.NotLogin span').show();
            $('.NotLogin img').hide();
        }
    }

	function getCatItem() {
		const tempNameCategory = "Makanan & Minuman";
		const tempUriCategory = `https://rekomendit.detik.com/makanan-minuman`;
		if(tempNameCategory != ''){
			$('.firstCatLogin').text(tempNameCategory);
            $('.firstCatLogin').attr('href', tempUriCategory);
		}else{
			$('.firstCatLogin').remove();
		}
	}
</script>
<!--e:detikconnect-client-->
